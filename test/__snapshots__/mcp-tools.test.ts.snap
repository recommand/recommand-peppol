// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`the MCP tools stay as models know them 1`] = `
[
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "List the companies the team sends and receives documents for, with their Peppol IDs, whether they're verified and whether they're registered to receive over Peppol. Use it to find the company a document is for.",
    "inputSchema": {
      "properties": {
        "enterpriseNumber": {
          "description": "Only the company with this enterprise number.",
          "examples": [
            "1234567894",
          ],
          "type": "string",
        },
        "limit": {
          "default": 50,
          "description": "How many companies per page, at most 100.",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "page": {
          "default": 1,
          "description": "The page to return, from 1.",
          "minimum": 1,
          "type": "integer",
        },
        "teamId": {
          "description": "The team to act in, as list_teams lists it. Leave it out when the connection reaches one team.",
          "type": "string",
        },
        "vatNumber": {
          "description": "Only the company with this VAT number.",
          "examples": [
            "BE1234567894",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "list_companies",
    "title": "List companies",
  },
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Find documents the team's companies sent or received: invoices, credit notes and other Peppol documents. Filter by direction, type, company, date, delivery status or unread ones (the inbox), or search by number, name or Peppol ID. Returns a summary per document; use get_document for one document's full contents and delivery details.",
    "inputSchema": {
      "$defs": {
        "DeliveryStatus": {
          "description": "\`pending\`: the channel accepted the document and has not confirmed arrival. \`delivered\`: the channel confirmed arrival; for Peppol the recipient's access point acknowledged the document, for email the recipient's mail server accepted the message. \`failed\`: the document did not arrive; for email the message bounced or was refused.",
          "enum": [
            "pending",
            "delivered",
            "failed",
          ],
          "type": "string",
        },
        "DocumentDirection": {
          "description": "Whether a document was received by a company (\`incoming\`) or sent by it (\`outgoing\`).",
          "enum": [
            "incoming",
            "outgoing",
          ],
          "examples": [
            "incoming",
          ],
          "type": "string",
        },
        "DocumentType": {
          "description": "The kind of document that was transmitted.",
          "enum": [
            "invoice",
            "creditNote",
            "selfBillingInvoice",
            "selfBillingCreditNote",
            "messageLevelResponse",
            "frenchInvoicingCdar",
            "frenchB2CSalesReport",
            "frenchB2CPaymentReport",
            "frenchB2BiInvoiceReport",
            "frenchB2BiPaymentReport",
            "unknown",
          ],
          "type": "string",
        },
      },
      "properties": {
        "companyId": {
          "description": "Only documents of this company, as list_companies lists it.",
          "type": "string",
        },
        "deliveryStatus": {
          "allOf": [
            {
              "$ref": "#/$defs/DeliveryStatus",
            },
          ],
          "description": "Only outgoing documents whose delivery is \`delivered\`, \`failed\` or still \`pending\`.",
          "examples": [
            "failed",
          ],
        },
        "direction": {
          "$ref": "#/$defs/DocumentDirection",
          "description": "Only received (\`incoming\`) or sent (\`outgoing\`) documents.",
        },
        "from": {
          "description": "Only documents sent or received from this moment on, in ISO 8601.",
          "examples": [
            "2024-01-01T00:00:00Z",
          ],
          "type": "string",
        },
        "limit": {
          "default": 20,
          "description": "How many documents per page, at most 50.",
          "maximum": 50,
          "minimum": 1,
          "type": "integer",
        },
        "page": {
          "default": 1,
          "description": "The page to return, from 1.",
          "minimum": 1,
          "type": "integer",
        },
        "search": {
          "description": "Words to look for in the document number, the sender's or receiver's name or Peppol ID.",
          "examples": [
            "invoice",
          ],
          "type": "string",
        },
        "teamId": {
          "description": "The team to act in, as list_teams lists it. Leave it out when the connection reaches one team.",
          "type": "string",
        },
        "to": {
          "description": "Only documents sent or received before this moment, in ISO 8601.",
          "examples": [
            "2024-12-31T23:59:59Z",
          ],
          "type": "string",
        },
        "type": {
          "allOf": [
            {
              "$ref": "#/$defs/DocumentType",
            },
          ],
          "description": "Only documents of this type.",
          "examples": [
            "invoice",
          ],
        },
        "unreadOnly": {
          "description": "Only received documents not marked as read yet: the inbox.",
          "type": "boolean",
        },
      },
      "type": "object",
    },
    "name": "search_documents",
    "title": "Search documents",
  },
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Get one document by ID: its contents (lines, totals, parties, payment details), and for a sent document whether it was delivered, and why not if a delivery failed. A long document's lines come a page at a time: \`linePagination\` says how many there are.",
    "inputSchema": {
      "properties": {
        "documentId": {
          "description": "The document's ID, as search_documents returns it.",
          "type": "string",
        },
        "limit": {
          "default": 50,
          "description": "How many of the document's lines to include, at most 100.",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "page": {
          "default": 1,
          "description": "The page of lines to include, from 1.",
          "minimum": 1,
          "type": "integer",
        },
        "teamId": {
          "description": "The team to act in, as list_teams lists it. Leave it out when the connection reaches one team.",
          "type": "string",
        },
      },
      "required": [
        "documentId",
      ],
      "type": "object",
    },
    "name": "get_document",
    "title": "Get a document",
  },
  {
    "annotations": {
      "openWorldHint": true,
      "readOnlyHint": true,
    },
    "description": "Find out whether a company can receive documents over Peppol. Give a \`peppolAddress\` (such as \`0208:0123456789\`) to check that it's registered and see the document types it accepts, or a \`name\` to search the Peppol directory for its address first.",
    "inputSchema": {
      "properties": {
        "name": {
          "description": "A company name, VAT or enterprise number to search the Peppol directory for.",
          "type": "string",
        },
        "peppolAddress": {
          "description": "A Peppol address as \`scheme:identifier\`, to check directly.",
          "type": "string",
        },
        "teamId": {
          "description": "The team to act in, as list_teams lists it. Leave it out when the connection reaches one team.",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "find_recipient",
    "title": "Find a recipient",
  },
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Get the fields of a document type, as JSON Schema: what prepare_send takes as \`document\` for that \`documentType\`. Call it before preparing a document of a type you haven't written yet.",
    "inputSchema": {
      "properties": {
        "documentType": {
          "description": "The document type to describe, such as \`invoice\`.",
          "enum": [
            "invoice",
            "creditNote",
            "selfBillingInvoice",
            "selfBillingCreditNote",
            "messageLevelResponse",
            "frenchInvoicingCdar",
            "xml",
          ],
          "examples": [
            "invoice",
          ],
          "type": "string",
        },
        "teamId": {
          "description": "The team to act in, as list_teams lists it. Leave it out when the connection reaches one team.",
          "type": "string",
        },
      },
      "required": [
        "documentType",
      ],
      "type": "object",
    },
    "name": "describe_document",
    "title": "Describe a document type",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    "description": "Check a document before sending it, without sending it: it's written, routed to the recipient and validated the way a send would. Call describe_document first for the fields \`document\` takes. Returns a summary to show the user, and a \`handle\` for exactly this document, valid for 15 minutes.",
    "inputSchema": {
      "$defs": {
        "PDFGeneration": {
          "description": "Optionally generate a PDF of the document and include it as an embedded attachment (also included in email attachments when email sending is enabled). Not supported for message level responses, French Invoicing CDAR messages, or raw XML documents.",
          "properties": {
            "enabled": {
              "default": false,
              "description": "Whether to generate a PDF of the document and include it as an embedded attachment.",
              "type": "boolean",
            },
            "filename": {
              "description": "Optional filename to use for the generated PDF attachment. Defaults to a filename derived from the document number (e.g. invoice-001.pdf).",
              "examples": [
                "INV-2024-001.pdf",
              ],
              "type": "string",
            },
          },
          "type": "object",
        },
      },
      "properties": {
        "companyId": {
          "description": "The company sending the document, as list_companies lists it.",
          "type": "string",
        },
        "doctypeId": {
          "description": "The Peppol document type identifier. Leave it out to send in the best format the recipient receives.",
          "examples": [
            "urn:oasis:names:specification:ubl:schema:xsd:Invoice-2::Invoice##urn:cen.eu:en16931:2017#compliant#urn:fdc:peppol.eu:2017:poacc:billing:3.0::2.1",
          ],
          "type": "string",
        },
        "document": {
          "anyOf": [
            {
              "additionalProperties": {},
              "type": "object",
            },
            {
              "type": "string",
            },
          ],
          "description": "The document, with the fields describe_document returns for its \`documentType\`; for \`xml\`, the XML itself.",
        },
        "documentType": {
          "description": "The type of document.",
          "enum": [
            "invoice",
            "creditNote",
            "selfBillingInvoice",
            "selfBillingCreditNote",
            "messageLevelResponse",
            "frenchInvoicingCdar",
            "xml",
          ],
          "examples": [
            "invoice",
          ],
          "type": "string",
        },
        "email": {
          "description": "Send the document by email too. Required, with \`to\`, when \`recipient\` is null.",
          "properties": {
            "htmlBody": {
              "description": "The email's HTML body. Written for the document when left out.",
              "type": "string",
            },
            "replyTo": {
              "description": "Where replies go. The document's issuer when left out.",
              "type": "string",
            },
            "subject": {
              "description": "The email's subject. Written for the document when left out.",
              "type": "string",
            },
            "to": {
              "description": "The addresses to email the document to.",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "when": {
              "description": "\`always\`, or only \`on_peppol_failure\`, the default, when Peppol can't deliver it.",
              "enum": [
                "always",
                "on_peppol_failure",
              ],
              "type": "string",
            },
          },
          "required": [
            "to",
          ],
          "type": "object",
        },
        "pdfGeneration": {
          "$ref": "#/$defs/PDFGeneration",
        },
        "processId": {
          "description": "The Peppol process identifier. Leave it out to use the one the document type and recipient call for.",
          "examples": [
            "urn:fdc:peppol.eu:2017:poacc:billing:01:1.0",
          ],
          "type": "string",
        },
        "recipient": {
          "description": "The recipient's Peppol address, such as \`0208:0123456789\`, as find_recipient checks it. Null to send by email only, which needs \`email.to\`.",
          "examples": [
            "0208:987654321",
          ],
          "type": [
            "string",
            "null",
          ],
        },
        "teamId": {
          "description": "The team to act in, as list_teams lists it. Leave it out when the connection reaches one team.",
          "type": "string",
        },
      },
      "required": [
        "companyId",
        "document",
        "documentType",
        "recipient",
      ],
      "type": "object",
    },
    "name": "prepare_send",
    "title": "Prepare a send",
  },
]
`;
